# Copie para ../.env.local (a pasta que contém os repositórios) ou aponte
# OFICINA_ENV_FILE para o arquivo. Nunca versione valores reais.

# Obrigatório, mínimo 32 bytes, compartilhado entre os serviços.
# Gere com: openssl rand -hex 32
APP_JWT_SECRET=

# Opcionais (vazio é aceito, com aviso). Vazio em NEW_RELIC_LICENSE_KEY desliga o agente.
NEW_RELIC_LICENSE_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Senhas locais (padrão: oficina). Também usadas pelo docker-compose.yml.
RABBITMQ_PASSWORD=oficina
OS_DB_PASSWORD=oficina
BILLING_DB_PASSWORD=oficina
EXECUTION_DB_PASSWORD=oficina

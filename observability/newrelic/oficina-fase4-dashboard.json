          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT count(*) FROM TransactionError WHERE appName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execution-service') FACET appName, error.class SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            }
          }
        },
        {
          "title": "Logs de erro e alerta por serviço",

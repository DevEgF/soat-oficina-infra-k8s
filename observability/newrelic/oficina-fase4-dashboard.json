{
  "name": "Oficina — Fase 4",
  "description": "Vazão e erro por serviço, duração da saga e sagas compensadas.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Serviços",
      "description": null,
      "widgets": [
        {
          "title": "Vazão por serviço (requisições e mensagens por minuto)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT rate(count(*), 1 minute) FROM Transaction WHERE appName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execution-service') FACET appName TIMESERIES"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            }
          }
        },
        {
          "title": "Taxa de erro por serviço (%)",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT percentage(count(*), WHERE error IS true) FROM Transaction WHERE appName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execution-service') FACET appName TIMESERIES"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            }
          }
        },
        {
          "title": "Tempo de resposta HTTP p95 (ms)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT percentile(duration * 1000, 95) FROM Transaction WHERE appName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execution-service') AND transactionType = 'Web' FACET appName TIMESERIES"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            }
          }
        },

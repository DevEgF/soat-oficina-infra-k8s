          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT count(*) FROM Log WHERE entity.name LIKE 'oficina-%' AND level IN ('ERROR', 'WARN') FACET entity.name, level TIMESERIES"

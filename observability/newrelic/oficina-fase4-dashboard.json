          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT count(*) FROM Transaction WHERE appName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execution-service') AND transactionType = 'Other' FACET name SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            }
          }
        },
        {
          "title": "Erros por classe",

    {
      "name": "Saga",
      "description": null,
      "widgets": [
        {
          "title": "Sagas finalizadas",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT count(*) FROM SagaFinished FACET outcome SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "Duração da saga (s)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 8,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8439293
                ],
                "query": "SELECT count(*) AS 'sagas', average(durationMs / 1000) AS 'média', percentile(durationMs / 1000, 95) AS 'p95', max(durationMs / 1000) AS 'máximo' FROM SagaFinished FACET outcome SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            }
          }
        },

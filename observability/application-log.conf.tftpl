# Send the original container message so EMF's _aws object stays at the event root.
# Only application-log.conf is overridden; host and dataplane defaults remain active.
%{ for environment in ["hml", "prod"] ~}
[INPUT]
    Name                tail
    Tag                 oficina.${environment}.*
    Path                /var/log/containers/*_${environment}_*.log
    multiline.parser    docker, cri
    DB                  /var/fluent-bit/state/flb_oficina_${environment}.db
    Mem_Buf_Limit       50MB
    Skip_Long_Lines     On
    Refresh_Interval    10
    Rotate_Wait         30
    storage.type        filesystem
    Read_from_Head      $${READ_FROM_HEAD}

[OUTPUT]
    Name                cloudwatch_logs
    Match               oficina.${environment}.*
    region              $${AWS_REGION}
    log_group_name      /aws/eks/${cluster_name}/${environment}/application
    log_stream_prefix   $${HOST_NAME}-
    auto_create_group   false
    log_key             log
    log_format          json/emf

%{ endfor ~}
